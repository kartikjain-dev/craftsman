#!/usr/bin/env bash
# Stop hook — after real code work in a session (marker dropped by the
# pretooluse-edit-guard hook), nudge a craftsman:caveats-and-status close-out
# exactly once. Loop-safe two ways: it honours stop_hook_active AND deletes the
# marker after firing, so it can never re-trigger itself. Fires nothing on
# chat-only sessions (no marker => no nudge). When the edit guard saw state
# writes (state-<session> marker), the same nudge also asks for those state
# machines to be checked. Self-contained.

set -uo pipefail

input="$(cat)"

pick_python() {
  for pybin in python3 python; do
    if command -v "$pybin" >/dev/null 2>&1 && "$pybin" -c "import sys" >/dev/null 2>&1; then
      printf '%s' "$pybin"; return 0
    fi
  done
  return 1
}

session_id=""
active="false"
if pybin=$(pick_python); then
  parsed="$(printf '%s' "$input" | "$pybin" -c "
import json, sys
d = json.load(sys.stdin)
print(str(d.get('session_id') or ''))
print('true' if d.get('stop_hook_active') else 'false')
" 2>/dev/null)"
  session_id="$(printf '%s' "$parsed" | sed -n '1p')"
  active="$(printf '%s' "$parsed" | sed -n '2p')"
else
  printf '%s' "$input" | grep -q '"stop_hook_active"[[:space:]]*:[[:space:]]*true' && active="true"
  session_id="$(printf '%s' "$input" | grep -o '"session_id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/.*:[[:space:]]*"//; s/"$//')"
fi

# Already continued once, or no session to key on: do nothing.
[ "$active" = "true" ] && exit 0
[ -n "$session_id" ] || exit 0

marker="${TMPDIR:-/tmp}/craftsman-hooks/edited-$session_id"
state_marker="${TMPDIR:-/tmp}/craftsman-hooks/state-$session_id"
[ -f "$marker" ] || exit 0
rm -f "$marker" 2>/dev/null || true

reason="Code changed this session. Before finishing, close out in the craftsman:caveats-and-status format: a Status section (what you actually ran and verified vs. what you did not) and a Caveats section (assumptions made, known gaps). If you already provided both, just stop."

# State writes this session (listed by pretooluse-edit-guard): ask for the
# changed machines to be checked as part of the same close-out.
if [ -f "$state_marker" ]; then
  files="$(head -n 8 "$state_marker" 2>/dev/null | sed 's|.*/||' | paste -sd ',' - | sed 's/,/, /g')"
  rm -f "$state_marker" 2>/dev/null || true
  reason="${reason} This session also changed state-machine code (${files}). In the close-out, say for each machine you touched whether you checked it with craftsman:implicit-state-machines step 3 (other writers of that state, a way out of every error or running state, guards on writes that must not go backwards, a crash between writes); list what you did not check under Caveats."
fi

if [ -n "${pybin:-}" ]; then
  REASON="$reason" "$pybin" -c 'import json, os; print(json.dumps({"decision": "block", "reason": os.environ["REASON"]}))'
else
  # No Python: file names may hold characters JSON needs escaped, so drop them.
  reason="$(printf '%s' "$reason" | tr -d '"\\')"
  printf '{"decision":"block","reason":"%s"}\n' "$reason"
fi

exit 0
